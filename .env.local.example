# ---- LLM (at least one required) ----
# Free tier, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free tier, no card: https://console.groq.com/keys   (fallback when Gemini rate-limits)
GROQ_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# ---- Sources (optional; each missing key skips that source) ----
# https://console.cloud.google.com -> enable "YouTube Data API v3" -> create API key
YOUTUBE_API_KEY=

# Reddit, route 1 (preferred, no Reddit account needed): Apify's public-page
# scraper. Free plan is $5/month with no card, and the actor bills $3.40 per
# 1,000 results, so ~1,400 documents. https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Dry-run override for the result cap; production default is 1200.
# APIFY_MAX_ITEMS=20

# Reddit, route 2 (used only when APIFY_TOKEN is unset): the official API.
# https://www.reddit.com/prefs/apps -> create app -> type "script"
# client id is the string under the app name; secret is labelled "secret"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
