# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds only empty keys and is what README's
# setup step tells a reader to copy.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pipeline
.env.local
data/cache/

# quarantined intermediates (superseded by a taxonomy re-run)
data/out/tags.stale-taxonomy.json
data/out/tags.superseded.json
data/resume-run.log
data/out/taxonomy.generic-v2.json
data/taxonomy-run.log
data/taxonomy-rerun.log
data/out/taxonomy.pre-edit.json

# scratch backups from paid re-runs
data/raw/*.bak

# reddit ingest + relevance run logs
data/reddit-full-run.log
data/reddit-gap-run.log
data/relevance-reddit.log
data/relevance-gap.log

# tagging run log
data/tag-run.log
